  "peak_hours_note": "DeepSeek bills by time of day. Windows below are UTC, on weekdays only, and Chinese public holidays bill off-peak all day. Off-peak is exactly half of peak. Taken from the footnote on DeepSeek's pricing page: 'Peak hours are 01:00 - 04:00 and 06:00 - 10:00 UTC, Monday through Friday, excluding Chinese public holidays.' Every other key here must be a vendor name.",
  "peak_hours": {
    "deepseek": {
      "utc_windows": [["01:00", "04:00"], ["06:00", "10:00"]],
      "weekdays_only": true,
      "skip_dates": [
        "2026-01-01", "2026-02-17", "2026-05-01",
        "2026-06-19", "2026-09-25", "2026-10-01"
      ],
      "skip_dates_source": "https://date.nager.at/api/v3/PublicHolidays/2026/CN",
      "skip_dates_note": "Statutory holidays only. The surrounding 调休 (shifted) days are still ordinary billing days, and the published State Council calendar adds bridge days that this list does not attempt to model -- a bridge day that is actually a holiday bills slightly high. Refresh this list each year.",
      "offpeak_multiplier": 0.5
    }
  },

