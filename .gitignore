# Runtime data: the scanned database is per-machine and must never be committed.
# Two spellings, because the package also writes into agent_token_radar/data/tmp
# during scans (read-only SQLite copies are made there).
data/
agent_token_radar/data/
*.db
*.db-shm
*.db-wal

# Icon build cache: re-generated by `python -m agent_token_radar._build_icons`
# when someone wants to refresh the vendor marks. The RESULT (icons.py) is
# committed, because the dashboard must work offline.
_icon_cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Build artifacts. The installer itself is attached to a GitHub Release rather
# than committed: it is ~18 MB and would sit in the history forever.
dist-installer/
*.exe

# Local probes and one-off measurement scripts (root level only, so package
# files like __init__.py cannot be caught by this pattern)
/_*.py
/_*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent instructions for this machine. Not published with the repo.
AGENTS.md
HANDOFF.md
